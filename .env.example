# Aperilex Local Development Environment Variables (Stage 5)

################################################################################
# Database (containers connect through docker-compose network aliases)
################################################################################
APERILEX_DATABASE__POSTGRES__HOST=postgres
APERILEX_DATABASE__POSTGRES__DATABASE=aperilex
APERILEX_DATABASE__POSTGRES__USERNAME=aperilex

# Secrets are sourced from the .secrets directory by docker-entrypoint.
# Do NOT commit values for Google OAuth or JWT keys to the repo.
DOCKER_SECRETS_DIR=.secrets

################################################################################
# Messaging (RabbitMQ remains the default local queue)
################################################################################
RABBITMQ_USER=aperilex
RABBITMQ_PASSWORD=dev_password
RABBITMQ_URL=amqp://aperilex:dev_password@localhost:5672/

################################################################################
# Authentication & Security (Stage 5 Google OAuth provider is mandatory)
################################################################################
SECRET_KEY=dev-secret-key-change-in-production-this-should-be-long
ENCRYPTION_KEY=dev-encryption-key-32-characters-long-enough
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Select the production-grade provider – no dev fallback in Stage 5
APERILEX_AUTHENTICATION_PROVIDER=GOOGLE_OAUTH

# JWT settings consumed by the provider factory
APERILEX_AUTHENTICATION__JWT_ISSUER=https://api.aperilex.local
APERILEX_AUTHENTICATION__JWT_AUDIENCE=aperilex
APERILEX_AUTHENTICATION__JWT_KEY_ID=local-dev
APERILEX_AUTHENTICATION__ACCESS_TOKEN_TTL_SECONDS=900
APERILEX_AUTHENTICATION__REFRESH_TOKEN_TTL_SECONDS=1209600

# Google OAuth redirect configuration (must match Google Cloud Console)
APERILEX_AUTHENTICATION__GOOGLE__REDIRECT_URI=http://localhost:3000/auth/google/callback
APERILEX_AUTHENTICATION__GOOGLE__SCOPE="openid email profile"
APERILEX_AUTHENTICATION__GOOGLE__ACCESS_TYPE=offline
APERILEX_AUTHENTICATION__GOOGLE__PROMPT=consent

# Google client ID/secret and JWT keys are mounted via docker secrets:
#   .secrets/GOOGLE_CLIENT_ID, .secrets/GOOGLE_CLIENT_SECRET
#   .secrets/JWT_PRIVATE_KEY, .secrets/JWT_PUBLIC_KEY

################################################################################
# Application Runtime
################################################################################
DEBUG=true
ENVIRONMENT=development
MESSAGING_ENVIRONMENT=development
QUEUE_SERVICE_TYPE=rabbitmq
WORKER_SERVICE_TYPE=docker
APP_NAME=Aperilex
APP_VERSION=2.0.0

################################################################################
# SEC API Identity (Required by SEC)
################################################################################
EDGAR_IDENTITY=your-email@yourdomain.com

################################################################################
# LLM Configuration (replace placeholders with your API credentials)
################################################################################
LLM_MODEL=gpt-4o-mini
# LLM_MODEL=gemini-2.5-flash
DEFAULT_LLM_PROVIDER=openai
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# OPENAI_API_KEY and GOOGLE_API_KEY are provided via docker secrets

################################################################################
# CORS & Logging
################################################################################
CORS_ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
LOG_LEVEL=DEBUG
LOG_FORMAT=json

################################################################################
# Storage Configuration
################################################################################
STORAGE_SERVICE_TYPE=local
LOCAL_STORAGE_PATH=./data

################################################################################
# Monitoring & Telemetry
################################################################################
PROMETHEUS_ENABLED=true
OPENTELEMETRY_ENABLED=false

################################################################################
# Docker User Configuration (set automatically by setup scripts if missing)
################################################################################
# UID=1000
# GID=1000
